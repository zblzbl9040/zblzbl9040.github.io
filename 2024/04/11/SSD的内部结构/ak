//*p = 20; 错误
p = &b; // 正确
```

```c++
/*
2.const修饰常量   ---指针常量
如:		int a = 10;
		int b = 10;
		int * const p = &a;    (指针常量)
		特点:指针的指向不可以改，指针指向的值可以改
		即:“* p = 15;”这个操作是合法的
		   “p = &b;”这个操作是非法的
*/
int* const p2 = &a;
//指针的指向不可以改，指针指向的值可以改
*p2 = 110;  //正确
//p2 = &b;  错误
```


```c++
/*
3.const既修饰指针，又修饰常量
如:		int a = 10;
		int b = 10;
		const int * const p = &a;
		特点:指针的指向和指针指向的值都不可以改
		即:“* p = 15;”这个操作是非法的
		   “p = &b;”这个操作是非法的
*/
int* p3 = &a;
const int* const p3 = &a;
//指针的指向和指针指向的值都不可以改
//*p3 = 100; 错误
//p3 = &b;   错误
```

**顶层const和底层const**

顶层`const`是指修饰对象本身，使该对象不可改变。也就是说，顶层 `const` 影响的是指针或引用的本身，或者一个普通变量本身。

```c++
const int a = 5;                // a 是顶层 const，表示 a 不可修改
int const b = 10;               // 和上面等价，b 也是顶层 const
int* const p1 = &a;             // p1 是顶层 const，表示 p1 不能指向别的地址（p1 不可修改）
```

底层` const `是指修饰对象所指向的内容或引用的目标对象，使该目标不可修改。它不影响指针本身或引用的绑定对象，但**影响它们所指向的值或对象**。

```c++
const int* p2 = &a;    // p2 是底层 const，表示 p2 指向的值（a）不可修改
int const* p3 = &b;    // 和上面等价，p3 是底层 const
const int* const p4 = &a; // p4 是顶层和底层 const，表示 p4 本身和指向的值都不可修改
```

==顶层const和底层const的区别就是一个是直接作用在对象上，另一个是作用在所指的对象或者是被引用的对象上==

在执行拷贝操作时，**底层const**的限制不能忽视。当执行对象的拷贝操作时，拷入和拷出的对象必须具有相同的底层const资格，或者两个对象的数据类型必须能够转换(一般来说，非常量可以转化为常量，反之则不行)。==主要是为了确保不破坏`const`的语义==

```c++
const int x = 10;  // x 是常量
int y = x;         // 正确：将常量拷贝到非常量（值拷贝，不涉及指针）
const int* p1 = &x;  // p1 是指向常量的指针
int* p2 = p1;        // 错误：不能将指向常量的指针赋值给普通指针

//示例(作用于函数参数传递)
void printValue(const int* ptr) {
    std::cout << *ptr << std::endl;
}

int main() {
    int x = 10;
    const int y = 20;
    printValue(&x);  // 正确：非常量可以传递给底层 const
    printValue(&y);  // 正确：常量可以传递给底层 const
    return 0;
}
```

==**关于`const`有很多需要注意的地方：**==

**(1)函数参数的顶层`const`不会影响传参方式，而底层`const`会影响参数匹配规则**

```c++
//1.顶层const不影响传参(即顶层const对参数匹配无影响，形参是否加const都可以接收)
void func1(const int x);  // 顶层 const
void func2(int x);        // 无 const
int main() {
    int a = 10;
    const int b = 20;

    func1(a);  // ✅ 可以传递
    func1(b);  // ✅ 也可以传递

    func2(a);  // ✅ 可以传递
    func2(b);  // ✅ 也可以传递
}

//2.底层const影响参数匹配
void func1(int* p);        // 普通指针
void func2(const int* p);  // 指向 const 的指针

int main() {
    int a = 10;
    const int b = 20;

    func1(&a);  // ✅ 正常，`int*` 传给 `int*`
    func1(&b);  // ❌ 错误，不能把 `const int*` 传给 `int*`

    func2(&a);  // ✅ 正常，`int*` 可以转换为 `const int*`
    func2(&b);  // ✅ 正常，`const int*` 可以转换为 `const int*`
}

//3.底层const影响引用传递
void func1(int& x);        // 普通引用
void func2(const int& x);  // 引用 const

int main() {
    int a = 10;
    const int b = 20;

    func1(a);  // ✅ 正常
    func1(b);  // ❌ 错误，`int&` 不能绑定 `const int`

    func2(a);  // ✅ 正常
    func2(b);  // ✅ 正常
}

/*
	顶层const只影响函数内部，调用时不影响匹配
	底层const影响参数匹配规则，普通指针/引用不能绑定const数据
*/
```

**(2)顶层`const`影响的是函数内部，而不是调用者**

```c++
void func(const int x) { 
    x = 10;  // ❌ 错误，x 是顶层 const，不可修改
}

int main() {
    int a = 5;
    func(a);  // a 仍然是 5，不受影响
}
```

**(3)顶层`const`对函数声明的影响**

```c++
void func(const int x);  // 声明
void func(int x);        // 声明

// 这两个声明是等价的，这点在函数重载时需要注意
void func(int x);        // ❌ 错误，与 `void func(const int)` 重复
void func(const int x);  // ❌ 错误，无法区分
```

**(4)底层`const`会影响函数重载**

```c++
void func(int* p);       // 非 const 指针
void func(const int* p); // 指向 const 的指针

int main() {
    int a = 10;
    const int b = 20;

    func(&a);  // 调用 void func(int* p)
    func(&b);  // 调用 void func(const int* p)
}
```

**(5)顶层`const`在传递引用时的影响**

```c++
void func1(int& x);       // 普通引用
void func2(const int& x); // 引用 const

int main() {
    int a = 10;
    const int b = 20;

    func1(a);  // ✅ 传递普通变量可以
    func1(b);  // ❌ 错误，不能把 `const int` 绑定到 `int&`
    
    func2(a);  // ✅ `const int&` 可以绑定到 `int`
    func2(b);  // ✅ `const int&` 也可以绑定到 `const int`
}
```

**(6)`const`形参对指针的影响**

```c++
void func1(int* p);        // 普通指针
void func2(const int* p);  // 指向 const 的指针
void func3(int* const p);  // 指针本身是 const

int main() {
    int a = 10;
    const int b = 20;

    func1(&a);  // ✅ 正常
    func1(&b);  // ❌ 错误，不能把 `const int*` 传递给 `int*`

    func2(&a);  // ✅ 正常，`int*` 可以转换为 `const int*`
    func2(&b);  // ✅ 正常，`const int*` 可以转换为 `const int*`
}
```

**(7)顶层`const`对返回值的影响**

```c++
const int func1() { return 10; }  // 返回 `const int`
int func2() { return 10; }        // 返回 `int`

int main() {
    int x = func1();  // ✅ x 是 `int`，顶层 const 被忽略
    const int y = func1();  // ✅ 仍然可用

    int& r = func2();  // ❌ 错误，不能绑定临时变量
    const int& r2 = func2();  // ✅ 可以绑定临时变量
}
```

**(8)顶层`const`影响`this`指针**

```c++
//在 class 中，const 成员函数会导致 this 指针变为 const：
class A {
public:
    void func1() { }       // 普通成员函数
    void func2() const { } // const 成员函数
};

int main() {
    A a;
    const A b;

    a.func1();  // ✅ 可以调用
    a.func2();  // ✅ 可以调用

    b.func1();  // ❌ 错误，不能调用非 const 成员函数
    b.func2();  // ✅ 可以调用
}
```

