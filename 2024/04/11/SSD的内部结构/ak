cout << "k4 = " << k4 << endl;    //160
int z = 15;
int k5 = z++ * 10;
cout << "k5 = " << k5 << endl;    //150

//前置递减
int w1 = 10;
--w1;
cout << "w1 = " << w1 << endl;    //9
//后置递减
int w2 = 10;
w2--;
cout << "w2 = " << w2 << endl;    //9
//前置递减和后置递减的区别
//前置递减 先让变量减1 然后在进行表达式运算
//后置递减 先将变量在表达式中运算，然后变量再减1
int w3 = 5;
cout << --w3 * 10 << endl;     //40
int w4 = 5;
cout << w4-- * 10 << endl;     //50
```

