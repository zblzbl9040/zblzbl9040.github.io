### 函数重载

名称和返回类型相同，但参数不同的函数被称为重载函数。在应用程序中，如果需要使用不同的 参数调用具有特定名称和返回类型的函数，就可以使用函数重载。
```c++
#include<iostream>
using namespace std;

const double PI = 3.14159265;
double Area(double radius);
double Area(double radius, double height);

int main() {
	cout << "输入y来计算圆柱的面积，输入n来计算圆的面积：" << endl;
	char userSelection;
	cin >> userSelection;
	if (userSelection == 'y') {
		cout << "pelase input radius:" << endl;
		double radius;
		cin >> radius;
		cout << "please input height:" << endl;
		double height;
		cin >> height;
		cout << "圆柱的表面积：" << Area(radius, height) << endl;
	}
	else {
		cout << "pelase input radius:" << endl;
		double radius;
		cin >> radius;
		cout << "圆的面积：" << Area(radius) << endl;
	}
	return 0;
}

double Area(double radius) {
	return PI * radius * radius;
}

double Area(double radius, double height) {
	return 2 * Area(radius) + 2 * PI * radius * height;
}
//代码中行声明了两个重载的 Area()函数的原型，一个接受一个参数—圆半径，另一个接受两个参数—圆柱的半径和高度。这两个函数同名，都叫 Area()，返回类型相同，都是 double，但参数不同，因此它们是重载的。
```

