	请声明一个5个元素的数组，并且将元素逆置
	(如原数组元素为:1,3,2,5,4;逆置后输出结果为:4,5,2,3,1);
*/

int main() {
	
	//案例1
	int arr1[5] = { 300,350,200,400,250 };
	int i = 0;
	int num = 0;
	num = arr1[0];
	for (i; i < 5; i++)
	{
		if (num < arr1[i])
		{
			num = arr1[i];
		}
	}
	cout << "最大的体重为:" << num << endl;

	//案例2
	int arr2[] = { 1,3,2,5,4 };
	cout << "数组逆置前:" << endl;
	int j ,temp;
	for (j = 0; j < 5; j++)
	{
		cout << arr2[j];
	}
	cout << endl;
	//实现逆置
	//记录起始下标的位置
	//记录结束下标的位置
	//起始下标与结束下标的元素互换
	//起始位置++  结束位置--
	//循环执行操作，直到起始位置 >= 结束位置
	int start = 0;
	int end = sizeof(arr2) / sizeof(arr2[0]) - 1;
	while (start < end)
	{
		//实现元素互换
		temp = arr2[start];
		arr2[start] = arr2[end];
		arr2[end] = temp;
		start++;
		end--;
	}
	for (j = 0; j < 5; j++)
	{
		cout << arr2[j];
	}
	return 0;
}
