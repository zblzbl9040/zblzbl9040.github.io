### 双目加法与双目减法运算符

**1.类成员函数的方式重载加法和减法运算符**
对于成员函数的重载，第一个操作数是当前对象(隐式的 `this`)，第二个操作数是传递给运算符重载函数的参数。

```c++
//语法
class ClassName {
public:
    return_type operator+(const ClassName& other) const;
    return_type operator-(const ClassName& other) const;
};
```

```c++
//示例
#include <iostream>
using namespace std;

class Complex {
private:
    double real, imag; 
public:
    Complex(double r = 0, double i = 0) : real(r), imag(i) {} 
    Complex operator+(const Complex& other) const {    // 加法运算符重载
        return Complex(this->real + other.real, this->imag + other.imag);
    }
    Complex operator-(const Complex& other) const {    // 减法运算符重载
        return Complex(this->real - other.real, this->imag - other.imag);
    }
    void display() const {
        cout << "(" << real << ", " << imag << ")" << endl;
    }
};

int main() {
    Complex num1(3.0, 4.0), num2(1.5, 2.5);
    Complex sum = num1 + num2;    // 使用重载的加法运算符
    Complex difference = num1 - num2;  // 使用重载的减法运算符
    sum.display();         // 输出：(4.5, 6.5)
    difference.display();  // 输出：(1.5, 1.5)
    return 0;
}
```

**2.全局函数的方式重载加法和减法运算符**
如果运算符需要两个类对象作为操作数，可以将运算符重载为全局函数。这样，两个操作数都需要作为参数传递。

```c++
//语法
return_type operator+(const ClassName& lhs, const ClassName& rhs);  
return_type operator-(const ClassName& lhs, const ClassName& rhs);  
//其中lhs表示左操作数，rhs表示右操作数
```

```c++
//示例
#include <iostream>
using namespace std;

class Complex {
private:
    double real, imag;
public:
    Complex(double r = 0, double i = 0) : real(r), imag(i) {}
    void display() const {
        cout << "(" << real << ", " << imag << ")" << endl;
    }
    // 友元函数，用于全局的加法运算符重载
    friend Complex operator+(const Complex& lhs, const Complex& rhs) {
        return Complex(lhs.real + rhs.real, lhs.imag + rhs.imag);
    }
    // 友元函数，用于全局的减法运算符重载
    friend Complex operator-(const Complex& lhs, const Complex& rhs) {
        return Complex(lhs.real - rhs.real, lhs.imag - rhs.imag);
    }
};

int main() {
    Complex num1(5.0, 7.0), num2(2.0, 3.0);
    Complex sum = num1 + num2;   // 使用全局函数的加法运算符
    Complex difference = num1 - num2;  // 使用全局函数的减法运算符
    sum.display();         // 输出：(7.0, 10.0)
    difference.display();  // 输出：(3.0, 4.0)
    return 0;
}
```

**将+运算符用作两个字符串拼接**

```c++
#include <iostream>
#include <cstring>
using namespace std;

class MyString {
private:
    char* str;
public:
    MyString(const char* inputStr = "") {
        str = new char[strlen(inputStr) + 1];
        strcpy(str, inputStr);
    }
    MyString(const MyString& other) {   //拷贝构造函数
        str = new char[strlen(other.str) + 1];
        strcpy(str, other.str);
    }
    ~MyString() {
        delete[] str;
    }
    MyString operator+(const MyString& other) const {      // 重载 + 运算符用于字符串拼接
        char* newStr = new char[strlen(str) + strlen(other.str) + 1];
        strcpy(newStr, str);        // 复制第一个字符串
        strcat(newStr, other.str);  // 连接第二个字符串
        MyString result(newStr);
        delete[] newStr;  // 释放临时字符串内存
        return result;
    }
    void display() const {
        cout << str << endl;
    }
};

int main() {
    MyString str1("Hello, ");
    MyString str2("world!");
   
    MyString result = str1 + str2;    // 使用重载的 + 运算符拼接字符串
    result.display();  // 输出拼接结果: "Hello, world!"
    return 0;
}
//在C++中，将+重载用作字符串拼接是很常见的，不过C++标准库中的std::string类已经为+运算符提供了重载，实现了字符串的拼接功能，不再需要自定义来实现。
```

### 实现运算符`+=`和`-=`的重载

`+=` 和 `-=` 运算符是 C++ 中常用的复合赋值运算符，它们的作用是将左侧的操作数与右侧操作数进行某种运算后，再将结果赋值给左侧的操作数。通过运算符重载，可以为自定义的类实现这些操作，确保它们能像内置类型一样使用。
==对于`+=` `-=`等这些运算符来说，重载时通常应该返回**对自身对象的引用**(*this)，这样可以支持链式调用，如：`a += b += c;`且复合赋值运算符的参数一般使用 `const` 引用，以避免不必要的复制并确保参数不会被修改。==

```c++
//重载语法
class MyClass {
public:
    // 重载 += 运算符
    MyClass& operator+=(const MyClass& other) {
        // 实现对象的相加逻辑
        this->value += other.value;
        return *this;
    }

    // 重载 -= 运算符
    MyClass& operator-=(const MyClass& other) {
        // 实现对象的相减逻辑
        this->value -= other.value;
        return *this;
    }
private:
    int value; 
};
```

```c++
//示例
#include<iostream>
using namespace std;

class MyClass {
private:
	int value;
public:
	MyClass(int v = 0) :value(v) {};
	MyClass& operator+=(const MyClass& other) {
		this->value += other.value;
		return *this;
	}
	MyClass& operator-=(const MyClass& other) {
		this->value -= other.value;
		return *this;
	}
	void Show() {
		cout << "value: " << value << endl;
	}
};

int main() {
	MyClass obj1(9);
	MyClass obj2(22);
	obj1 += obj2;
	obj1.Show();
	obj1 -= obj2;
	obj1.Show();
	return 0;
}
```

```c++
//右操作数不是类的对象也可以，不一定非得是类的对象
#include<iostream>
using namespace std;

class MyClass {
private:
	int value;
public:
	MyClass(int v = 0) :value(v) {};
	MyClass& operator+=(int num) {
		this->value += num;
		return *this;
	}
	void Show() {
		cout << "value: " << value << endl;
	}
};

int main() {
	MyClass obj1(10);
	obj1 += 5;
	obj1.Show();
	return 0;
