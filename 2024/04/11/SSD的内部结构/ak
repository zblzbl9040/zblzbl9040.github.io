cout << !a << endl;
a = 0;
cout << !a << endl;

// && 与
int b = 1;
cout << (a&&b) << endl;
a = 10;
cout << (a && b) << endl;

// || 或
cout << (a || b) << endl;
```

### 按位运算符

按位运算符包括：NOT(~)、AND(&)、OR(|)、XOR(^)、左移(<<)和右移(>>)。

```c++
#include <iostream>
//#include<bitset>

using namespace std;

int main() {
    unsigned int a = 60;  // 60 = 0011 1100
    unsigned int b = 13;  // 13 = 0000 1101
    unsigned int result = 0; // 用于存储结果

    // 按位与运算符 (&)
    result = a & b;       // 12 = 0000 1100
    cout << "Result of a & b: " << result << endl;

    // 按位或运算符 (|)
    result = a | b;       // 61 = 0011 1101
    cout << "Result of a | b: " << result << endl;

    // 按位异或运算符 (^)
    result = a ^ b;       // 49 = 0011 0001
    cout << "Result of a ^ b: " << result << endl;

    // 按位取反运算符 (~)
    result = ~a;          // -61 = 1100 0011
    cout << "Result of ~a: " << result << endl;

    // 左移运算符 (<<)
    result = a << 2;      // 240 = 1111 0000
    cout << "Result of a << 2: " << result << endl;

    // 右移运算符 (>>)
    result = a >> 2;      // 15 = 0000 1111
    cout << "Result of a >> 2: " << result << endl;

    return 0;
}
```

### 三目运算符

三目运算符的作用是通过三目运算符实现简单的判断，语法：` 表达式1 ？ 表达式2 ：表达式3`
解释:
如果表达式1的值为真，执行表达式2，并返回表达值2的结果
如果表达式1的值为假，执行表达式3，并返回表达式3的结果

```c++
int A, B, C;
cout << "请为A输入一个值:" << endl;
cin >> A;
cout << "请为B输入一个值:" << endl;
cin >> B;
cout << "请为C输入一个值:" << endl;
cin >> C;
int max;
max = (A > B) ? (A > C ? A : C) : (B > C ? B : C);  //三目运算符比较3个数的大小
cout << "最大的值为:" << max << endl;
```

